# Autenticação das chamadas feitas pelo Copilot Studio.
ROUTES_API_KEY=gere-uma-chave-longa-e-aleatoria

# Segredo independente usado somente para assinar links temporários.
FILE_SIGNING_SECRET=gere-outro-segredo-longo-e-aleatorio

# Credencial existente da API Analytics do Checklist Fácil.
CHECKLIST_FACIL_API_TOKEN=substitua-pela-chave-real
CHECKLIST_FACIL_CATEGORY_ID=2879584
CHECKLIST_FACIL_TIMEZONE=America/Sao_Paulo

# URL HTTPS pública do serviço FastAPI, sem barra no final.
PUBLIC_API_BASE_URL=https://calculador-de-rotas-api.onrender.com

# Links de Excel expiram em 15 minutos. Limites aceitos: 60 a 86400.
FILE_TTL_SECONDS=900
MAX_GENERATED_FILE_MB=25

# IDs opcionais. Use 0 para manter a descoberta automática pelo nome.
CHECKLIST_ITEM_ODOMETER_START_ID=0
CHECKLIST_ITEM_ODOMETER_END_ID=0
CHECKLIST_ITEM_REASON_ID=0
CHECKLIST_ITEM_COST_CENTER_ID=0
CHECKLIST_ITEM_GPS_START_ID=0
CHECKLIST_ITEM_GPS_END_ID=0
