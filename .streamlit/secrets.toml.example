# Copie este arquivo para .streamlit/secrets.toml no ambiente local.
# No Streamlit Community Cloud, cadastre o mesmo conteúdo em Settings > Secrets.
# Nunca versione o arquivo secrets.toml real.

[checklist_facil]
api_token = "COLE_A_CHAVE_DA_API_AQUI"
category_id = 2879584
timezone = "America/Sao_Paulo"

# Informe os IDs reais da categoria. Quando um ID fica como 0, a aplicação
# tenta localizar um único item por nome e mostra o catálogo na interface.
[checklist_facil.items]
odometer_start_item_id = 0
odometer_end_item_id = 0
reason_item_id = 0
cost_center_item_id = 0
gps_start_item_id = 0
gps_end_item_id = 0
